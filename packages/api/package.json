{
  "name": "@awmusic/api",
  "version": "0.1.0",
  "description": "Backend API for AWMusic",
  "main": "./src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@awmusic/shared": "workspace:*",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "typescript": "~5.9.2",
    "tsx": "^4.19.2",
    "vitest": "^4.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.0.0"
  }
}
